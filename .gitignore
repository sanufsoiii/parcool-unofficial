# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat

# Architectury / Loom
.architectury-transformer/
**/explodedCommon/
**/loom-cache/

# Minecraft dev environment (generated by the run tasks)
run/
run-server/
**/run/
**/run-server/
**/.mixin.out/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/
out/

# OS
.DS_Store
Thumbs.db
.directory

# Release artifacts: built by ./gradlew build and copied here for distribution.
/*.jar

# The per-module build/ directories are already covered by `build/`, but a stray jar dropped next
# to a module's build.gradle would not be, so name the distribution outputs too.
common/build/libs/
fabric/build/libs/
neoforge/build/libs/
*.class

# Build logs and pasted game-session dumps. They carry the local path layout, the player name and
# the whole resource-reload noise, and are of no use to anyone reading the port.
*.log
*.txt
